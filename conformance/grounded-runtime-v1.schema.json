          "title": "Schema Version",
          "type": "integer"
        },
        "value": {
          "maximum": 90,
          "minimum": 1,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "role",
        "value"
      ],
      "title": "EditorialLiteral",
      "type": "object"
    },
    "ExportRequest": {
      "$defs": {
        "ItemVersion": {
          "additionalProperties": false,
          "properties": {
            "content_hash": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "title": "Content Hash",
              "type": "string"
            },
            "evidence_generation": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "title": "Evidence Generation",
              "type": "string"
            },
            "item_id": {
              "pattern": "^\\S(?:[^\\x00-\\x1f]*\\S)?$",
              "title": "Item Id",
              "type": "string"
            },
            "revision": {
              "exclusiveMinimum": 0,
              "title": "Revision",
              "type": "integer"
            },
            "schema_version": {
              "const": 1,
              "default": 1,
              "title": "Schema Version",
              "type": "integer"
            }
          },
          "required": [
            "item_id",
            "revision",
            "content_hash",
            "evidence_generation"
          ],
          "title": "ItemVersion",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "actor_label": {
          "pattern": "^\\S(?:[^\\x00-\\x1f]*\\S)?$",
          "title": "Actor Label",
          "type": "string"
        },
        "expected_sequence": {
          "minimum": 0,
          "title": "Expected Sequence",
          "type": "integer"
        },
        "generation": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Generation",
          "type": "string"
        },
        "idempotency_key": {
          "pattern": "^\\S(?:[^\\x00-\\x1f]*\\S)?$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ItemVersion"
          },
          "title": "Items",
          "type": "array"
        },
        "policy_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Hash",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "actor_label",
        "generation",
        "policy_hash",
        "expected_sequence",
        "items"
      ],
      "title": "ExportRequest",
      "type": "object"
    },
    "PassageCitation": {
      "$defs": {
        "EvidenceKey": {
          "additionalProperties": false,
