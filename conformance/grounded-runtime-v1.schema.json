    "Policy": {
      "additionalProperties": false,
      "properties": {
        "edition": {
          "default": "grounded-policy.v1",
          "pattern": "^\\S(?:[^\\x00-\\x1f]*\\S)?$",
          "title": "Edition",
          "type": "string"
        },
        "max_bundle_items": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Bundle Items",
