    "PassageEvidence": {
      "$defs": {
        "EvidenceKey": {
          "additionalProperties": false,
          "description": "Domain-neutral resolution key; a reference is not proof that evidence exists.",
          "properties": {
            "evidence_id": {
              "pattern": "^\\S(?:[^\\x00-\\x1f]*\\S)?$",
              "title": "Evidence Id",
              "type": "string"
            },
            "generation": {
              "maxLength": 64,
